<Window x:Class="LabSnapWord.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabSnap Word — University Lab Report Assistant"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Width="1140"
        Height="760"
        MinWidth="920"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{StaticResource BgPrimaryBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BRAND HEADER BAR -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,12"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app_logo.png"
                           Width="40"
                           Height="40"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LabSnap Word"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <Border Background="#1E3A8A"
                                    BorderBrush="#3B82F6"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="7,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="v2.0 • Live Word Sync"
                                           Foreground="#93C5FD"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Capture (Ctrl + Shift + S), crop, and insert screenshots directly into Microsoft Word (even while open!)"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right Header Actions: Install App to PC & Keep on Top -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="InstallAppButton"
                            Content="⬇ Install App to PC"
                            Style="{StaticResource ModernButton}"
                            Padding="14,7"
                            FontSize="12"
                            Click="InstallAppButton_Click"
                            Margin="0,0,14,0"/>
                    <CheckBox x:Name="AlwaysOnTopCheckBox"
                              Content="Pin Window on Top"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Checked="AlwaysOnTopCheckBox_Changed"
                              Unchecked="AlwaysOnTopCheckBox_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE: LEFT STEP-BY-STEP SIDEBAR + RIGHT INTERACTIVE CROPPER -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="375"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: GUIDED 1-2-3 STEPS -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- STEP 1: WORD REPORT FILE -->
                <Border Grid.Row="0"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="15,13"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="STEP 1 • CHOOSE WORD FILE"
                                       Foreground="#38BDF8"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            <TextBlock Text="● Works while open in Word"
                                       Foreground="#10B981"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBox x:Name="WordFilePathTextBox"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True"
                                 Text="No Word (.docx) file chosen yet"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ChooseWordFileButton"
                                    Grid.Column="0"
                                    Content="📂 Browse"
                                    Style="{StaticResource ModernButton}"
                                    Padding="8,8"
                                    Click="ChooseWordFileButton_Click"/>
                            <Button x:Name="CreateWordFileButton"
                                    Grid.Column="2"
                                    Content="✨ New .docx"
                                    Style="{StaticResource ModernButton}"
                                    Padding="8,8"
                                    Click="CreateWordFileButton_Click"/>
                            <Button x:Name="OpenInWordButton"
                                    Grid.Column="4"
                                    Content="↗ Open Word"
                                    Style="{StaticResource ModernButton}"
                                    Padding="8,8"
                                    IsEnabled="False"
                                    Click="OpenInWordButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- STEP 2: CAPTURE SCREENSHOT -->
                <Border Grid.Row="1"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="15,13"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="STEP 2 • CAPTURE SCREENSHOT"
                                   Foreground="#38BDF8"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

                        <Button x:Name="SnipRegionButton"
                                Style="{StaticResource PrimaryButton}"
                                Padding="14,11"
                                Margin="0,0,0,8"
                                Click="SnipRegionButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✂️  Snip Screen Region"
                                           FontSize="14"
                                           FontWeight="Bold"/>
                                <TextBlock Text="  (Ctrl + Shift + S)"
                                           Foreground="#BFDBFE"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CaptureFullScreenButton"
                                    Grid.Column="0"
                                    Content="🖥️ Full Screen"
                                    Style="{StaticResource ModernButton}"
                                    Padding="6,8"
                                    FontSize="12"
                                    Click="CaptureFullScreenButton_Click"/>
                            <Button x:Name="PasteClipboardButton"
                                    Grid.Column="2"
                                    Content="📋 Clipboard"
                                    Style="{StaticResource ModernButton}"
                                    Padding="6,8"
                                    FontSize="12"
                                    Click="PasteClipboardButton_Click"/>
                            <Button x:Name="LoadImageFileButton"
                                    Grid.Column="4"
                                    Content="🖼️ From File"
                                    Style="{StaticResource ModernButton}"
                                    Padding="6,8"
                                    FontSize="12"
                                    Click="LoadImageFileButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- STEP 3: TASK HEADING & ADD TO WORD -->
                <Border Grid.Row="2"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="15,13"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="STEP 3 • TASK HEADING &amp; INSERT"
                                       Foreground="#38BDF8"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="AutoIncrementTaskCheckBox"
                                      Content="Auto +1 Task #"
                                      IsChecked="True"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontSize="11"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Heading Title (inserted above screenshot):"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TaskHeadingTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource ModernTextBox}"
                                     Text="Task 1: "/>
                            <Button x:Name="NextTaskNumberButton"
                                    Grid.Column="2"
                                    Content="+1 Task"
                                    Style="{StaticResource ModernButton}"
                                    Padding="10,7"
                                    FontSize="12"
                                    Click="NextTaskNumberButton_Click"/>
                        </Grid>

                        <TextBlock Text="Optional Note / Description:"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="TaskNotesTextBox"
                                 Style="{StaticResource ModernTextBox}"
                                 Text=""
                                 Margin="0,0,0,12"/>

                        <Button x:Name="AddToWordButton"
                                Style="{StaticResource SuccessButton}"
                                Padding="16,13"
                                FontSize="14"
                                IsEnabled="False"
                                Click="AddToWordButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕  Add Screenshot to Word"
                                           FontWeight="Bold"
                                           FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- SESSION HISTORY LOG -->
                <Border Grid.Row="3"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="ADDED IN THIS SESSION"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6"/>
                        <ListBox x:Name="SessionHistoryListBox"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 FontSize="12"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT MAIN AREA: INTERACTIVE PREVIEW & CROP STUDIO -->
            <Border Grid.Column="2"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Crop Studio Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="INTERACTIVE CROP &amp; PREVIEW"
                                       Foreground="#38BDF8"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="ImageDimensionsText"
                                       Text="Press Ctrl + Shift + S anytime to snip a screenshot, then drag here to crop"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ApplyCropButton"
                                    Content="✂️ Apply Crop"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="14,7"
                                    FontSize="12"
                                    IsEnabled="False"
                                    Click="ApplyCropButton_Click"
                                    Margin="0,0,8,0"/>
                            <Button x:Name="ResetCropButton"
                                    Content="↩ Reset Original"
                                    Style="{StaticResource ModernButton}"
                                    Padding="12,7"
                                    FontSize="12"
                                    IsEnabled="False"
                                    Click="ResetCropButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Canvas Container -->
                    <Border Grid.Row="1"
                            Background="#070B14"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            ClipToBounds="True">
                        <Grid>
                            <!-- Welcome Empty State -->
                            <StackPanel x:Name="EmptyStatePanel"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        MaxWidth="420">
                                <Image Source="pack://application:,,,/Assets/app_logo.png"
                                       Width="88"
                                       Height="88"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16"/>
                                <TextBlock Text="Ready to Capture Your Lab Task"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="1. Choose or create your Word (.docx) file on the left (you can keep it open in Microsoft Word!).&#x0a;2. Press Ctrl + Shift + S or click 'Snip Screen Region' to grab your screenshot.&#x0a;3. Drag on the image here to crop, then click 'Add Screenshot to Word'."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           LineHeight="20"
                                           Margin="0,0,0,20"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✂️ Snip Screen (Ctrl + Shift + S)"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="18,10"
                                            Click="SnipRegionButton_Click"
                                            Margin="0,0,10,0"/>
                                    <Button Content="🖥️ Capture Full Screen"
                                            Style="{StaticResource ModernButton}"
                                            Padding="18,10"
                                            Click="CaptureFullScreenButton_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Interactive Crop Viewbox (1 Canvas unit = 1 Image Pixel) -->
                            <Viewbox x:Name="PreviewViewbox"
                                     Stretch="Uniform"
                                     Visibility="Collapsed">
                                <Grid x:Name="ImageWorkspaceGrid">
                                    <Image x:Name="PreviewImage"
                                           Stretch="Fill"/>

                                    <Canvas x:Name="CropOverlayCanvas"
                                            Background="#01000000"
                                            Cursor="Cross"
                                            MouseLeftButtonDown="CropOverlayCanvas_MouseLeftButtonDown"
                                            MouseMove="CropOverlayCanvas_MouseMove"
                                            MouseLeftButtonUp="CropOverlayCanvas_MouseLeftButtonUp"
                                            MouseRightButtonDown="CropOverlayCanvas_MouseRightButtonDown">

                                        <!-- Darkened Outside Mask Rectangles (Dim area outside crop selection) -->
                                        <Rectangle x:Name="MaskTop" Fill="#99000000" Visibility="Collapsed" IsHitTestVisible="False"/>
                                        <Rectangle x:Name="MaskBottom" Fill="#99000000" Visibility="Collapsed" IsHitTestVisible="False"/>
                                        <Rectangle x:Name="MaskLeft" Fill="#99000000" Visibility="Collapsed" IsHitTestVisible="False"/>
                                        <Rectangle x:Name="MaskRight" Fill="#99000000" Visibility="Collapsed" IsHitTestVisible="False"/>

                                        <!-- Active Crop Selection Box -->
                                        <Border x:Name="CropSelectionBorder"
                                                BorderBrush="#38BDF8"
                                                BorderThickness="3"
                                                Background="Transparent"
                                                Visibility="Collapsed"
                                                IsHitTestVisible="False"/>
                                    </Canvas>
                                </Grid>
                            </Viewbox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Grid Grid.Row="2" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusBannerText"
                       Grid.Column="0"
                       Text="Ready. Press Ctrl + Shift + S anytime to capture a screenshot."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="SessionCounterText"
                       Grid.Column="1"
                       Text="Total added this session: 0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
