<Window x:Class="LabSnapWord.Views.SnipOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snip Screen Region"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Cursor="Cross"
        Background="Black"
        KeyDown="Window_KeyDown">
    <Grid>
        <Image x:Name="BackgroundScreenImage"
               Stretch="Fill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

        <Canvas x:Name="SnipCanvas"
                Background="#55000000"
                MouseLeftButtonDown="SnipCanvas_MouseLeftButtonDown"
                MouseMove="SnipCanvas_MouseMove"
                MouseLeftButtonUp="SnipCanvas_MouseLeftButtonUp"
                MouseRightButtonDown="SnipCanvas_MouseRightButtonDown">

            <Border x:Name="InstructionBanner"
                    Canvas.Left="24"
                    Canvas.Top="24"
                    Background="#E60F172A"
                    BorderBrush="#3B82F6"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,10"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✂️ Drag across the screen to snip a region"
                               Foreground="#F8FAFC"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="   •   Press ESC or Right-Click to cancel"
                               Foreground="#94A3B8"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="SelectionBorder"
                    BorderBrush="#38BDF8"
                    BorderThickness="2"
                    Background="#2238BDF8"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"/>

            <Border x:Name="DimensionsBadge"
                    Background="#E60F172A"
                    BorderBrush="#38BDF8"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,4"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock x:Name="DimensionsText"
                           Text="0 × 0 px"
                           Foreground="#F8FAFC"
                           FontSize="12"
                           FontWeight="SemiBold"/>
            </Border>
        </Canvas>
    </Grid>
</Window>
