<Window x:Class="LabSnapWord.Views.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabSnap Word Setup"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Width="520"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120">
    <Border Margin="20"
            Background="#151F32"
            BorderBrush="#263554"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <Image Source="pack://application:,,,/Assets/app_logo.png"
                       Width="64"
                       Height="64"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="0,0,16,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Install LabSnap Word"
                               Foreground="#F8FAFC"
                               FontSize="20"
                               FontWeight="Bold"/>
                    <TextBlock Text="Version 2.0 • Standalone Windows Installer"
                               Foreground="#38BDF8"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,3,0,2"/>
                    <TextBlock Text="All components built-in — no internet or downloads required."
                               Foreground="#94A3B8"
                               FontSize="12"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#0B1120"
                    BorderBrush="#1E293B"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="INSTALLATION OPTIONS"
                               Foreground="#64748B"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <CheckBox x:Name="DesktopShortcutCheckBox"
                              Content="Create a 'LabSnap Word' icon on my Windows Desktop"
                              IsChecked="True"
                              Foreground="#F8FAFC"
                              FontSize="13"
                              Margin="0,0,0,10"/>

                    <CheckBox x:Name="StartMenuCheckBox"
                              Content="Add 'LabSnap Word' to the Windows Start Menu"
                              IsChecked="True"
                              Foreground="#F8FAFC"
                              FontSize="13"
                              Margin="0,0,0,10"/>

                    <CheckBox x:Name="LaunchAfterInstallCheckBox"
                              Content="Launch LabSnap Word immediately after installation"
                              IsChecked="True"
                              Foreground="#F8FAFC"
                              FontSize="13"
                              Margin="0,0,0,14"/>

                    <TextBlock x:Name="InstallLocationText"
                               Text="Install location: Local AppData\Programs\LabSnapWord"
                               Foreground="#64748B"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"/>

                    <ProgressBar x:Name="InstallProgressBar"
                                 Height="6"
                                 Margin="0,12,0,0"
                                 Background="#1E293B"
                                 Foreground="#10B981"
                                 Visibility="Collapsed"
                                 IsIndeterminate="True"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="RunPortableButton"
                        Grid.Column="0"
                        Content="Run Without Installing"
                        Style="{StaticResource ModernButton}"
                        Padding="14,10"
                        Click="RunPortableButton_Click"/>

                <Button x:Name="InstallNowButton"
                        Grid.Column="2"
                        Content="Install Now"
                        Style="{StaticResource SuccessButton}"
                        Padding="26,10"
                        FontSize="14"
                        Click="InstallNowButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
