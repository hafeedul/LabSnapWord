<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LabSnapWord</AssemblyName>
    <RootNamespace>LabSnapWord</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Native Windows Executable Icon & App Metadata -->
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <Title>LabSnap Word</Title>
    <Product>LabSnap Word</Product>
    <Description>Screenshot Cropper &amp; Word Lab Report Builder for Windows</Description>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <Target Name="RestoreBinaryIcons" BeforeTargets="BeforeBuild;PrepareForBuild;BeforeResGen" Condition="!Exists('Assets\app_icon.ico') Or !Exists('Assets\app_logo.png')">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;if (-not (Test-Path 'Assets/app_logo.png') -and (Test-Path 'Assets/app_logo.png.b64')) { [IO.File]::WriteAllBytes('Assets/app_logo.png', [Convert]::FromBase64String((Get-Content 'Assets/app_logo.png.b64' -Raw))) }; if (-not (Test-Path 'Assets/app_icon.ico') -and (Test-Path 'Assets/app_icon.ico.b64')) { [IO.File]::WriteAllBytes('Assets/app_icon.ico', [Convert]::FromBase64String((Get-Content 'Assets/app_icon.ico.b64' -Raw))) }&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <ItemGroup>
    <Resource Include="Assets\app_icon.ico" />
    <Resource Include="Assets\app_logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.20.0" />
  </ItemGroup>

</Project>
